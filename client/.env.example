# ------------------------------------------------------------------
# Front-end (Vite) environment variables
# Copy this file to `.env` and adjust the API base URL.
# Every variable must start with VITE_ to be exposed to the browser.
# ------------------------------------------------------------------

# Local development: your local Express API
VITE_API_URL=http://localhost:5000/api

# Deployed example:
# VITE_API_URL=https://your-api-name.onrender.com/api
